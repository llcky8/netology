<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Нужно allure-kotlin-android (TestStorageResultsWriter/
         ExternalStoragePermissionsListener), чтобы писать результаты
         через androidx.test.services в общее хранилище (/sdcard/...),
         а не во внутреннее приватное хранилище приложения. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

</manifest>
